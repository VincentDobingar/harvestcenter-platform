# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "__PASSENGER_APP_ROOT__"
PassengerBaseURI "/"
PassengerNodejs "__PASSENGER_NODEJS_PATH__"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

Options -MultiViews -Indexes
DirectorySlash Off
RewriteEngine On

# PassengerAppRoot / PassengerBaseURI above make this directory both the
# app root AND the Apache document root: any file that physically exists
# here is served directly by Apache, bypassing the Node app entirely.
# Confirmed on 2026-09-07: /package.json was fetchable at
# https://api.harvestcentertd.org/package.json (HTTP 200), and again on
# 2026-10-09: /server.js, /app.js and /config/db.js were all fetchable in
# plain text because the extension list below never included .js — block
# every source/config extension, not just the ones found so far, so only
# the app's own routes (and Express's explicit /uploads static mount)
# remain reachable. The two Passenger values above are filled in by
# deploy.yml from the REMOTE_API_PATH / PASSENGER_NODEJS_PATH secrets for
# the target environment (see DEPLOY.md) — this file is now rsynced like
# any other, it is no longer a manual hand-edit on the server.
<FilesMatch "\.(env|sql|sh|log|md|json|yml|yaml|lock|js|mjs|cjs|ts|map)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "^(deploy_key.*|id_rsa.*|id_ed25519.*)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  SetEnvIfNoCase Origin "^https://(www\.)?harvestcentertd\.org$" ACAO=$0
  SetEnvIfNoCase Origin "^http://localhost:(3000|5173|4173)$" ACAO=$0

  Header always set Access-Control-Allow-Origin "%{ACAO}e" env=ACAO
  Header always set Access-Control-Allow-Credentials "true" env=ACAO
  Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" env=ACAO
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With" env=ACAO
  Header always set Vary "Origin"
</IfModule>